# Copy these settings into your local environment or a private .env file.
# Never commit real credentials or company Sheet identifiers to this public repository.

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_WORKSHEET=大宗材料 行情統計表

# The current authoritative monthly company sheet uses day-of-month rows.
COMPANY_SHEET_DATE_FORMAT=DAY

# Safety gate: default is dry-run. Set to 1 only after a company-PC live-source
# comparison confirms all 11 values and the target row.
ALLOW_GOOGLE_SHEET_WRITE=0

# Local/internal audit snapshot; runtime/ is excluded from Git.
COMPANY_MARKET_AUDIT_PATH=runtime/company-market/latest.json
