# Copy these settings into your local environment or a private .env file.
# Never commit real credentials or company Sheet identifiers to this public repository.

GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_WORKSHEET=大宗材料 行情統計表

# Date contract: column A must use complete Google Sheets dates displayed as yyyy/mm/dd.
# Day-only values such as 26 are intentionally not accepted.
COMPANY_SHEET_DATE_FORMAT=yyyy/mm/dd

# Safety gate: 0 = Live Dry Run. It performs real LME/SMM/yfinance retrieval and
# real Google Sheet validation, but does not modify any Sheet cells.
# A real write requires BOTH settings. CONTROLLED_WRITE_APPROVAL is deliberately
# bound to the approved date and range; never store a real approval in this file.
ALLOW_GOOGLE_SHEET_WRITE=0
CONTROLLED_WRITE_APPROVAL=
# Example shape only: APPROVE-C3.1-WRITE-yyyy/mm/dd-A17:L17

# Local/internal audit snapshot; runtime/ is excluded from Git.
COMPANY_MARKET_AUDIT_PATH=runtime/company-market/latest.json
