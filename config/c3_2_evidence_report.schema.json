{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "title": "C3.2-7 evidence report", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "report_id", "report_revision", "report_created_at", "report_sha256", "run_id", "wrapper_execution_id", "scheduled_slot", "execution_kind", "scheduler_task_name", "scheduler_instance_id", "scheduler_trigger_kind", "scheduler_execution_datetime", "validator_execution_datetime", "exit_origin", "scheduler_result", "wrapper_result", "runner_result", "validator_result", "runner_log_reference", "runner_log_sha256", "date_context", "source_readiness", "canonical_evaluation", "append_result", "readback_result", "append_only_status", "production_status", "a_l_change", "canonical_persistence_status", "repository_version", "warnings", "failures", "not_verified", "blocked", "evidence_references", "final_result", "pass_scope"],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertion": {"type": "object", "additionalProperties": false, "required": ["value", "basis", "evidence_reference", "observed_at", "evidence_sha256"], "properties": {"value": {}, "basis": {"enum": ["OBSERVED", "DERIVED", "NOT_VERIFIED"]}, "evidence_reference": {"type": ["string", "null"]}, "observed_at": {"type": ["string", "null"], "format": "date-time"}, "evidence_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]}}}
  },
  "properties": {
    "schema_version": {"const": "c3_2_7.evidence.v1"}, "report_id": {"type": "string", "minLength": 1}, "report_revision": {"type": "integer", "minimum": 1}, "report_created_at": {"type": "string", "format": "date-time"}, "report_sha256": {"$ref": "#/$defs/hash"}, "run_id": {"$ref": "#/$defs/hash"}, "wrapper_execution_id": {"type": "string", "minLength": 1},
    "scheduled_slot": {"type": ["string", "null"], "format": "date-time"}, "execution_kind": {"enum": ["NATURAL", "RECOVERY", "MANUAL", "RETRY", "MISSED", "DUPLICATE", "AMBIGUOUS"]}, "scheduler_task_name": {"type": "string", "minLength": 1}, "scheduler_instance_id": {"type": "string", "minLength": 1}, "scheduler_trigger_kind": {"type": ["string", "null"]}, "scheduler_execution_datetime": {"type": ["string", "null"], "format": "date-time"}, "validator_execution_datetime": {"type": "string", "format": "date-time"}, "exit_origin": {"enum": ["RUNNER", "VALIDATOR"]},
    "scheduler_result": {"$ref": "#/$defs/assertion"}, "wrapper_result": {"$ref": "#/$defs/assertion"}, "runner_result": {"$ref": "#/$defs/assertion"}, "validator_result": {"$ref": "#/$defs/assertion"}, "runner_log_reference": {"$ref": "#/$defs/assertion"}, "runner_log_sha256": {"$ref": "#/$defs/hash"}, "date_context": {"$ref": "#/$defs/assertion"}, "source_readiness": {"$ref": "#/$defs/assertion"}, "canonical_evaluation": {"$ref": "#/$defs/assertion"}, "append_result": {"$ref": "#/$defs/assertion"}, "readback_result": {"$ref": "#/$defs/assertion"}, "append_only_status": {"$ref": "#/$defs/assertion"}, "production_status": {"$ref": "#/$defs/assertion"}, "a_l_change": {"$ref": "#/$defs/assertion"}, "canonical_persistence_status": {"$ref": "#/$defs/assertion"}, "repository_version": {"$ref": "#/$defs/assertion"},
    "warnings": {"type": "array", "items": {"type": "string"}}, "failures": {"type": "array", "items": {"type": "string"}}, "not_verified": {"type": "array", "items": {"type": "string"}}, "blocked": {"type": "array", "items": {"type": "string"}}, "evidence_references": {"type": "array", "items": {"type": "string"}}, "final_result": {"enum": ["PASS", "WARNING", "FAIL", "BLOCKED"]}, "pass_scope": {"enum": ["SHADOW_OPERATIONAL_ONLY", null]}
  }
}
