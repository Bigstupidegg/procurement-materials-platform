{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:c4-rd:schema:c4-availability-assessment:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["assessment_type", "subject_id", "assessment_role", "evaluation_at", "rule_bundle_version", "availability_basis", "result", "evidence"],
  "properties": {
    "assessment_type": {"const": "AVAILABILITY"}, "subject_id": {"$ref": "urn:c4-rd:schema:c4-common:1.0.0#/$defs/sha256"},
    "assessment_role": {"type": "string", "minLength": 1}, "evaluation_at": {"$ref": "urn:c4-rd:schema:c4-common:1.0.0#/$defs/rfc3339"},
    "rule_bundle_version": {"type": "string", "minLength": 1}, "availability_basis": {"$ref": "urn:c4-rd:schema:c4-common:1.0.0#/$defs/availabilityBasis"},
    "result": {"type": "object"}, "evidence": {"type": "object"}, "assessed_at": {"oneOf": [{"$ref": "urn:c4-rd:schema:c4-common:1.0.0#/$defs/rfc3339"}, {"type": "null"}]}, "created_at": {"oneOf": [{"$ref": "urn:c4-rd:schema:c4-common:1.0.0#/$defs/rfc3339"}, {"type": "null"}]}
  }
}
