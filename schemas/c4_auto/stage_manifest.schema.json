{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c4-auto:schema:stage-manifest:1.3.0",
  "title": "C4-AUTO Stage Manifest R1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "stage_id", "manifest_version", "description", "contract", "design_gate", "base", "scope", "change_classification", "counterexamples", "acceptance_criteria", "test_tiers", "remediation", "evidence_requirements", "rollback_boundary"],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)[.][.](?:/|$)).+$"},
    "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "exit_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "test_check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "argv", "timeout_seconds", "expected_exit_codes", "expected_test_count", "allowed_skips", "required_sentinel"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,79}$"}, "kind": {"const": "TEST"},
        "argv": {"$ref": "#/$defs/argv"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "expected_exit_codes": {"$ref": "#/$defs/exit_codes"}, "expected_test_count": {"type": "integer", "minimum": 1},
        "allowed_skips": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}},
        "required_sentinel": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "validation_check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "argv", "timeout_seconds", "expected_exit_codes", "required_sentinel"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,79}$"}, "kind": {"const": "VALIDATION"},
        "argv": {"$ref": "#/$defs/argv"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "expected_exit_codes": {"$ref": "#/$defs/exit_codes"}, "required_sentinel": {"type": "string", "minLength": 1}
      }
    },
    "replay_check": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "argv", "timeout_seconds", "expected_exit_codes", "required_sentinel"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,79}$"}, "kind": {"const": "REPLAY"},
        "argv": {"$ref": "#/$defs/argv"}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "expected_exit_codes": {"$ref": "#/$defs/exit_codes"}, "required_sentinel": {"type": "string", "minLength": 1}
      }
    },
    "check": {"oneOf": [{"$ref": "#/$defs/test_check"}, {"$ref": "#/$defs/validation_check"}, {"$ref": "#/$defs/replay_check"}]},
    "tier": {"type": "object", "additionalProperties": false, "required": ["required", "checks"], "properties": {"required": {"type": "boolean"}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}}}
  },
  "properties": {
    "schema_version": {"const": "c4_auto.stage_manifest.v1"},
    "document_type": {"const": "c4_auto_stage_manifest"},
    "stage_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{2,79}$"},
    "manifest_version": {"const": "1.3.0"},
    "description": {"$ref": "#/$defs/nonempty"},
    "contract": {"type": "object", "additionalProperties": false, "required": ["contract_id", "contract_version", "contract_sha256"], "properties": {"contract_id": {"const": "C4-AUTO-ENGINEERING-CONTRACT"}, "contract_version": {"const": "1.3.0"}, "contract_sha256": {"$ref": "#/$defs/hash"}}},
    "design_gate": {"type": "object", "additionalProperties": false, "required": ["approval_id", "approved_base_sha", "approved_at"], "properties": {"approval_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{2,127}$"}, "approved_base_sha": {"$ref": "#/$defs/git_sha"}, "approved_at": {"type": "string", "format": "date-time"}}},
    "base": {"type": "object", "additionalProperties": false, "required": ["branch", "sha"], "properties": {"branch": {"$ref": "#/$defs/nonempty"}, "sha": {"$ref": "#/$defs/git_sha"}}},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["allowed_paths", "protected_files", "test_contract_paths", "allowed_preexisting_changes"],
      "properties": {
        "allowed_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "protected_files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}}},
        "test_contract_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/path"}},
        "allowed_preexisting_changes": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}}}}
      }
    },
    "change_classification": {"const": "BOUNDED_FIX"},
    "counterexamples": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "invariant", "check_id", "expected_result"], "properties": {"id": {"type": "string", "pattern": "^([A-Z0-9]+-)*CE-[0-9]{2,}$"}, "invariant": {"type": "string", "pattern": "^INV-(0[1-9]|1[0-5])$"}, "check_id": {"$ref": "#/$defs/nonempty"}, "expected_result": {"type": "object", "additionalProperties": false, "required": ["passed", "failure_reasons"], "properties": {"passed": {"type": "boolean"}, "failure_reasons": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/nonempty"}}}}}}},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "source_check", "field", "operator", "expected", "required", "evidence_basis"], "properties": {"id": {"type": "string", "pattern": "^AC-[0-9]{2,}$"}, "source_check": {"$ref": "#/$defs/nonempty"}, "field": {"$ref": "#/$defs/nonempty"}, "operator": {"enum": ["EQ", "NE", "GE", "LE", "TRUE", "FALSE", "EMPTY", "NOT_EMPTY"]}, "expected": {}, "required": {"const": true}, "evidence_basis": {"enum": ["OBSERVED", "DERIVED"]}}}},
    "test_tiers": {"type": "object", "additionalProperties": false, "required": ["targeted", "focused", "coupled", "full", "replay_e2e"], "properties": {"targeted": {"$ref": "#/$defs/tier"}, "focused": {"$ref": "#/$defs/tier"}, "coupled": {"$ref": "#/$defs/tier"}, "full": {"$ref": "#/$defs/tier"}, "replay_e2e": {"$ref": "#/$defs/tier"}}},
    "remediation": {"type": "object", "additionalProperties": false, "required": ["max_cycles", "root_cause_required"], "properties": {"max_cycles": {"const": 2}, "root_cause_required": {"const": true}}},
    "evidence_requirements": {"type": "object", "additionalProperties": false, "required": ["machine_json", "markdown_derived", "required_fields"], "properties": {"machine_json": {"const": true}, "markdown_derived": {"const": true}, "required_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["verdict", "evidence_sha256", "approval_boundary_id", "ledger_tip_sha256", "candidate_seal_sha256"]}}}},
    "rollback_boundary": {"type": "object", "additionalProperties": false, "required": ["reversible", "instructions"], "properties": {"reversible": {"const": true}, "instructions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}}}}
  }
}
