{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c4-auto:schema:engineering-contract:1.3.0",
  "title": "C4-AUTO Engineering Contract R1.3",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_type", "contract_id", "contract_version", "canonicalization", "global_invariants", "global_hard_gates", "approval_boundary_policy", "remediation_policy", "scope_policy", "test_tier_policy", "evidence_policy", "security_policy", "child_command_trust_model", "runner_capabilities", "rollback_policy", "verdicts"],
  "$defs": {"nonempty": {"type": "string", "minLength": 1}},
  "properties": {
    "schema_version": {"const": "c4_auto.engineering_contract.v1"}, "document_type": {"const": "c4_auto_engineering_contract"}, "contract_id": {"const": "C4-AUTO-ENGINEERING-CONTRACT"}, "contract_version": {"const": "1.3.0"},
    "canonicalization": {"type": "object", "additionalProperties": false, "required": ["encoding", "json_sort_keys", "json_separators", "hash_algorithm"], "properties": {"encoding": {"const": "UTF-8"}, "json_sort_keys": {"const": true}, "json_separators": {"const": [",", ":"]}, "hash_algorithm": {"const": "SHA-256"}}},
    "global_invariants": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name", "rule"], "properties": {"id": {"type": "string", "pattern": "^INV-(0[1-9]|1[0-5])$"}, "name": {"$ref": "#/$defs/nonempty"}, "rule": {"$ref": "#/$defs/nonempty"}}}},
    "global_hard_gates": {"type": "array", "minItems": 17, "maxItems": 17, "items": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string", "pattern": "^HG-[A-Z0-9-]+$"}, "name": {"$ref": "#/$defs/nonempty"}}}},
    "approval_boundary_policy": {"type": "object", "additionalProperties": false, "required": ["identity_inputs", "approved_digests_are_authority", "run_id_is_authority", "terminal_state_persists_across_runs", "remediation_budget_scope", "test_baseline_scope"], "properties": {"identity_inputs": {"const": ["stage_id", "contract_sha256", "manifest_sha256", "approved_base_sha", "approval_id"]}, "approved_digests_are_authority": {"const": true}, "run_id_is_authority": {"const": false}, "terminal_state_persists_across_runs": {"const": true}, "remediation_budget_scope": {"const": "APPROVAL_BOUNDARY"}, "test_baseline_scope": {"const": "APPROVAL_BOUNDARY"}}},
    "remediation_policy": {"type": "object", "additionalProperties": false, "required": ["max_cycles", "root_cause_required", "structured_classification_required", "architecture_change_allowed", "acceptance_change_allowed", "authoritative_semantic_change_allowed", "rights_boundary_change_allowed"], "properties": {"max_cycles": {"const": 2}, "root_cause_required": {"const": true}, "structured_classification_required": {"const": true}, "architecture_change_allowed": {"const": false}, "acceptance_change_allowed": {"const": false}, "authoritative_semantic_change_allowed": {"const": false}, "rights_boundary_change_allowed": {"const": false}}},
    "scope_policy": {"type": "object", "additionalProperties": false, "required": ["detect_committed", "detect_staged", "detect_unstaged", "detect_untracked", "ignore_git_ignored_runtime", "recheck_between_tiers", "candidate_seal_required", "seal_authority", "repository_state_dimensions", "index_source", "candidate_seal_version", "test_baseline_dual_state"], "properties": {"detect_committed": {"const": true}, "detect_staged": {"const": true}, "detect_unstaged": {"const": true}, "detect_untracked": {"const": true}, "ignore_git_ignored_runtime": {"const": true}, "recheck_between_tiers": {"const": true}, "candidate_seal_required": {"const": true}, "seal_authority": {"const": "ALLOWED_PATHS"}, "repository_state_dimensions": {"const": ["APPROVED_BASE_HEAD", "GIT_INDEX", "WORKING_TREE", "UNTRACKED_ABSENT"]}, "index_source": {"const": "GIT_LS_FILES_STAGE_Z"}, "candidate_seal_version": {"const": 2}, "test_baseline_dual_state": {"const": true}}},
    "test_tier_policy": {"type": "object", "additionalProperties": false, "required": ["ordered_tiers", "supported_check_kinds", "full_on_stable_candidate_only", "required_tiers_cannot_be_omitted", "unexpected_skips_fail", "ambiguous_counts_fail", "zero_tests_fail"], "properties": {"ordered_tiers": {"const": ["targeted", "focused", "coupled", "full", "replay_e2e"]}, "supported_check_kinds": {"const": ["TEST", "VALIDATION", "REPLAY"]}, "full_on_stable_candidate_only": {"const": true}, "required_tiers_cannot_be_omitted": {"const": true}, "unexpected_skips_fail": {"const": true}, "ambiguous_counts_fail": {"const": true}, "zero_tests_fail": {"const": true}}},
    "evidence_policy": {"type": "object", "additionalProperties": false, "required": ["machine_primary", "markdown_derived_only", "approval_ledger_required", "event_tail_anchored", "basis_values", "declared_satisfies_machine_criteria", "not_verified_satisfies_machine_criteria", "preserve_conflicts", "redact_logs"], "properties": {"machine_primary": {"const": true}, "markdown_derived_only": {"const": true}, "approval_ledger_required": {"const": true}, "event_tail_anchored": {"const": true}, "basis_values": {"const": ["OBSERVED", "DERIVED", "DECLARED", "NOT_VERIFIED"]}, "declared_satisfies_machine_criteria": {"const": false}, "not_verified_satisfies_machine_criteria": {"const": false}, "preserve_conflicts": {"const": true}, "redact_logs": {"const": true}}},
    "security_policy": {"type": "object", "additionalProperties": false, "required": ["remote_schema_resolution", "shell_execution", "serialize_environment", "serialize_secrets", "serialize_raw_argv", "inherit_pythonpath", "serialize_private_payloads"], "properties": {"remote_schema_resolution": {"const": false}, "shell_execution": {"const": false}, "serialize_environment": {"const": false}, "serialize_secrets": {"const": false}, "serialize_raw_argv": {"const": false}, "inherit_pythonpath": {"const": false}, "serialize_private_payloads": {"const": false}}},
    "child_command_trust_model": {"type": "object", "additionalProperties": false, "required": ["model", "side_effect_sandbox_claimed", "human_approval_is_trust_root"], "properties": {"model": {"const": "HUMAN_APPROVED_FROZEN_LOCAL_VALIDATION"}, "side_effect_sandbox_claimed": {"const": false}, "human_approval_is_trust_root": {"const": true}}},
    "runner_capabilities": {"type": "object", "additionalProperties": false, "required": ["commit", "push", "create_pr", "merge", "deploy", "network_acquisition", "authoritative_write", "private_write", "historical_pdf_acquisition"], "properties": {"commit": {"const": false}, "push": {"const": false}, "create_pr": {"const": false}, "merge": {"const": false}, "deploy": {"const": false}, "network_acquisition": {"const": false}, "authoritative_write": {"const": false}, "private_write": {"const": false}, "historical_pdf_acquisition": {"const": false}}},
    "rollback_policy": {"type": "object", "additionalProperties": false, "required": ["development_tooling_only", "irreversible_migration_allowed", "default_action"], "properties": {"development_tooling_only": {"const": true}, "irreversible_migration_allowed": {"const": false}, "default_action": {"const": "REVERT_TOOLING_AND_RETURN_TO_MANUAL_VALIDATION"}}},
    "verdicts": {"const": ["PASS_CANDIDATE", "FAIL", "HUMAN_REVIEW_REQUIRED"]}
  }
}
